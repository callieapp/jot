#compdef jot
# zsh completion for jot. The candidates come from jot itself, which
# knows its commands, their options and what they take.
_jot() {
    local -a candidates
    local tab=$'\t' line value about
    # The words without the quotes and backslashes they were typed with.
    for line in "${(@f)$(jot __complete "${(@Q)words[2,CURRENT]}" 2>/dev/null)}"; do
        [[ -n $line ]] || continue
        value=${line%%$tab*}
        about=
        [[ $line == *$tab* ]] && about=${line#*$tab}
        # _describe reads a colon as the start of the description.
        candidates+=("${value//:/\\:}${about:+:$about}")
    done
    _describe -t jot 'jot' candidates
}
_jot "$@"
